# Copy to .env.local. Never commit real values.
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# model | fallback | mock. Mock and fallback use the same local rubric.
MODEL_MODE=mock
# compatible | openai
MODEL_PROVIDER=compatible
# json_schema | json_object | text. OpenAI requires json_schema.
MODEL_RESPONSE_FORMAT=json_schema
# Base URL already includes /v1. Set the exact model ID exposed by the server.
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
# Optional for compatible endpoints. OpenAI requires its own key and model name.
MODEL_API_KEY=

# Shared secret ElevenLabs sends as the x-tool-secret header
VOICE_TOOL_SECRET=change-me

SIM_SPEED=4
